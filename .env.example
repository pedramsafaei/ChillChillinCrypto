# API Configuration
REACT_APP_CRYPTO_API_URL=https://api.coingecko.com/api/v3
REACT_APP_CRYPTO_API_KEY=your_api_key_here

# Alternative API (CoinRanking)
REACT_APP_COINRANKING_API_URL=https://api.coinranking.com/v2
REACT_APP_COINRANKING_API_KEY=your_coinranking_api_key_here

# News API
REACT_APP_NEWS_API_URL=https://newsapi.org/v2
REACT_APP_NEWS_API_KEY=your_news_api_key_here

# Application Configuration
REACT_APP_NAME=ChillChillin Crypto
REACT_APP_VERSION=1.0.0
REACT_APP_ENVIRONMENT=development

# Feature Flags
REACT_APP_ENABLE_NOTIFICATIONS=true
REACT_APP_ENABLE_PWA=true
REACT_APP_ENABLE_ANALYTICS=false

# Refresh Intervals (in milliseconds)
REACT_APP_PRICE_REFRESH_INTERVAL=30000
REACT_APP_NEWS_REFRESH_INTERVAL=300000

# Pagination
REACT_APP_DEFAULT_PAGE_SIZE=50
REACT_APP_MAX_PAGE_SIZE=100
